# Copier en .env.local (jamais commité).
DATABASE_URL=file:./dev.db
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Développement : Mailpit (lancer `mailpit`, voir les e-mails sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ERP <no-reply@example.test>

# Vrais e-mails (démo live) : Resend en SMTP, domaine vérifié requis pour MAIL_FROM
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# MAIL_FROM=ERP <bonjour@votre-domaine.com>
