# Copier en .env.local. Valeurs réelles jamais commitées.
# PostgreSQL de développement : docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
DATABASE_URL=postgresql://erp:erp_local_only@localhost:5434/erp?schema=public
APP_URL=http://localhost:3000

# Resend : clé « sending_access » restreinte au domaine d'envoi vérifié.
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=Comptoir <notifications@notify.example.com>
# Secret du webhook Resend (whsec_...), endpoint : https://<domaine>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Boîte de test autorisée (la vôtre) pour le test de réception réelle.
RESEND_TEST_TO=

# Production uniquement (docker-compose.yml) : mot de passe PostgreSQL et domaine servi par Caddy.
# POSTGRES_PASSWORD=
# APP_DOMAIN=erp.example.com
